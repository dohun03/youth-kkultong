{
  "name": "youth-kkultong",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start:api": "npm run start --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "test": "npm run test --workspace apps/api",
    "migration:run": "npm run migration:run --workspace apps/api",
    "migration:show": "npm run migration:show --workspace apps/api"
  },
  "devDependencies": {
    "typescript": "6.0.2"
  }
}
