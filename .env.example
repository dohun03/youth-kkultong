# 기존 .env를 덮어쓰지 말고 아래 항목을 추가한다.
# URL에서도 사용할 수 있도록 영문·숫자 비밀번호를 사용한다.
# 생성 예: openssl rand -hex 32
POSTGRES_PASSWORD=

# Compose는 위 비밀번호로 내부 db:5432의 DATABASE_URL을 구성한다.
# 호스트에서 API/테스트/Migration을 직접 실행할 때만 접근 가능한 DB 주소를 설정한다.
# 기본 Compose DB는 호스트에 포트를 공개하지 않는다.
# 로컬 DBeaver 접속: docker compose -f compose.yaml -f compose.local.yaml up -d db
# 위 로컬 설정을 함께 적용하면 127.0.0.1:5433으로 접속할 수 있다.
# DATABASE_URL=postgresql://youth_kkultong:비밀번호@127.0.0.1:5433/youth_kkultong

# 조회 서버와 Migration은 키 없이 실행 가능하며, 수집에는 제품용 인증키가 필요하다.
# 기존 조사용 YOUTH_API_KEY를 자동 대체하지 않는다.
YOUTH_CENTER_API_KEY=
YOUTH_CENTER_PAGE_SIZE=50
YOUTH_CENTER_REQUEST_DELAY_MS=3000
# 첫 요청 포함 1~3회, 저장 묶음 1~200건. SPEC 한도를 넘기면 기동 오류다.
YOUTH_CENTER_MAX_ATTEMPTS=3
POLICY_IMPORT_BATCH_SIZE=200
TZ=Asia/Seoul
# 쉼표로 구분한 정확한 웹 출처. 경로·마지막 /·와일드카드는 쓰지 않는다.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTP API 시작 시 필수. 수집·Migration·시드 CLI는 관리자 자격 없이 실행 가능하다.
ADMIN_USERNAME=
# 초기 해시 준비 방법: docs/mvp-2/SUMMARY.md 20절. 해시 전체를 작은따옴표로 감싼다.
ADMIN_PASSWORD_HASH=''
# 무작위 32바이트 이상을 base64로 저장. 생성 예: openssl rand -base64 32
ADMIN_AUTH_SECRET=
# HTTPS 출처 권장. 로컬 HTTP는 localhost 또는 127.0.0.1만 허용한다.
ADMIN_WEB_ORIGIN=http://localhost:3000
