# 기존 .env는 아래 구분에 맞춰 정리하고 실제 비밀값은 유지한다.

# 1. PC에서 접속할 IP와 포트 (Docker Compose용)
# 컨테이너 내부 포트는 웹 3000, API 4000, DB 5432로 유지한다.
BIND_IP=127.0.0.1
WEB_PORT=3000
API_PORT=4000
# compose.local.yaml을 함께 사용할 때만 DB 포트를 PC에 공개한다.
DB_PORT=5433

# 2. 데이터베이스
# Compose는 아래 세 값으로 Docker 내부 db:5432의 DATABASE_URL을 만든다.
# DB 이름이나 사용자를 바꾸기 전 해당 DB와 계정을 별도로 준비한다.
POSTGRES_DB=youth_kkultong
POSTGRES_USER=youth_kkultong
# URL에 사용할 수 있는 영문·숫자 비밀번호. 생성 예: openssl rand -hex 32
POSTGRES_PASSWORD=

# PC에서 Node로 API/테스트/Migration을 직접 실행할 때만 사용하는 접속 주소.
# 로컬 DB 공개: docker compose -f compose.yaml -f compose.local.yaml up -d db
# DB_PORT, DB 이름, 사용자, 비밀번호를 바꾸면 이 주소도 직접 맞춘다.
# .env를 읽는 API 코드는 ${변수명}을 자동 치환하지 않으므로 완성된 주소를 적는다.
# DATABASE_URL=postgresql://youth_kkultong:비밀번호@127.0.0.1:5433/youth_kkultong

# 3. 웹 주소와 공통 설정
# WEB_PORT를 바꾸면 아래 웹 주소와 5번의 ADMIN_WEB_ORIGIN도 맞춘다.
# 출처는 쉼표로 구분하고 경로·마지막 /·와일드카드는 쓰지 않는다.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TZ=Asia/Seoul

# 4. 온통청년 수집
# 조회와 Migration은 키 없이 실행 가능하며 실제 수집에만 제품용 키가 필요하다.
YOUTH_CENTER_API_KEY=
YOUTH_CENTER_PAGE_SIZE=50
YOUTH_CENTER_REQUEST_DELAY_MS=3000
# 페이지당 첫 요청 포함 1~3회, 저장 묶음 1~200건.
YOUTH_CENTER_MAX_ATTEMPTS=3
POLICY_IMPORT_BATCH_SIZE=200
# true인 단일 HTTP API에서 매일 한국 시간 04:00 수집. 기본은 비활성화.
# 중지 중 놓친 실행은 자동 보충하지 않는다.
POLICY_SCHEDULE_ENABLED=false

# 5. 관리자 인증
# HTTP API에 필수. 수집/Migration/시드 CLI에는 관리자 자격이 필요하지 않다.
ADMIN_USERNAME=
# 초기 해시 준비: docs/mvp-2/SUMMARY.md 20절. 해시 전체를 작은따옴표로 감싼다.
ADMIN_PASSWORD_HASH=''
# 무작위 32바이트 이상 base64. 생성 예: openssl rand -base64 32
ADMIN_AUTH_SECRET=
# 실제 접속하는 웹 출처 한 개. 로컬 HTTP는 localhost 또는 127.0.0.1을 사용한다.
ADMIN_WEB_ORIGIN=http://localhost:3000
