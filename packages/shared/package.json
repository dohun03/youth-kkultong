{
  "name": "@youth-kkultong/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./policies": {
      "types": "./src/policies.ts",
      "default": "./dist/policies.js"
    },
    "./policy-search.schema": {
      "types": "./src/policy-search.schema.ts",
      "default": "./dist/policy-search.schema.js"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
