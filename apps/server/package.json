{
  "name": "@kkultong/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "db:migrate": "typeorm-ts-node-commonjs -d src/database/datasource.ts migration:run",
    "db:revert": "typeorm-ts-node-commonjs -d src/database/datasource.ts migration:revert",
    "db:seed": "ts-node src/database/seeds/run-seeds.ts",
    "import:policies": "ts-node src/cli/import-policies.ts",
    "policy:validate": "ts-node src/cli/import-policies.ts --file ../../data/policies/policies.json --dry-run",
    "policy:import": "ts-node src/cli/import-policies.ts --file ../../data/policies/policies.json"
  },
  "dependencies": {
    "@kkultong/contracts": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.3",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
